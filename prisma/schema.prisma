generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  TREASURER
  BOARD
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum MemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXITED
}

enum SavingsAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET
  PASSWORD_CHANGE
  DISBURSE
  SIGN
  EXPORT
  DEPOSIT
  WITHDRAW
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum NotificationType {
  WELCOME
  PASSWORD_RESET
  SECURITY
  SYSTEM
}

enum AuthIdentifierType {
  MEMBER_NUMBER
  USERNAME
  EMAIL
  PHONE
}

enum PasswordResetChannel {
  EMAIL
  SMS
  ADMIN_ASSISTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INTEREST
  DIVIDEND
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
}

model User {
  id                   String                 @id @default(cuid())
  username             String?
  email                String?
  phone                String?
  passwordHash         String
  role                 UserRole
  memberId             String?                @unique
  status               UserStatus             @default(ACTIVE)
  mustChangePassword   Boolean                @default(true)
  lastLoginAt          DateTime?
  tempCredentialIssuedAt DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  member               Member?                @relation(fields: [memberId], references: [id], onDelete: SetNull)
  auditLogs            AuditLog[]             @relation("AuditActor")
  notifications        Notification[]
  passwordResetRequests PasswordResetRequest[]
  performedTransactions Transaction[]         @relation("TransactionPerformer")
  loanDecisions         LoanApplication[]     @relation("LoanDecisionMaker")
  loanApprovalSteps     LoanApprovalStep[]
  disbursedLoans        Loan[]                @relation("LoanDisburser")
  recordedLoanPayments LoanPayment[]

  @@index([role])
  @@index([status])
}

model Member {
  id               String             @id @default(cuid())
  memberNumber     String             @unique
  firstName        String
  lastName         String
  dateOfBirth      DateTime?
  nationalIdNumber String
  address          String
  phone            String
  email            String?
  nextOfKinName    String
  nextOfKinPhone   String
  photoUrl         String?
  enrollmentDate   DateTime           @default(now())
  status           MemberStatus       @default(PENDING)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User?
  savingsAccount   SavingsAccount?
  loanApplications LoanApplication[]
  loans            Loan[]

  @@index([status])
  @@index([createdAt])
}

model SavingsAccount {
  id            String               @id @default(cuid())
  memberId      String               @unique
  accountNumber String               @unique
  balance       Decimal              @default(0) @db.Decimal(18, 2)
  status        SavingsAccountStatus @default(ACTIVE)
  openedAt      DateTime             @default(now())
  member        Member               @relation(fields: [memberId], references: [id], onDelete: Restrict)
  transactions  Transaction[]

  @@index([status])
}

model Transaction {
  id               String          @id @default(cuid())
  savingsAccountId String
  type             TransactionType
  amount           Decimal         @db.Decimal(18, 2)
  balanceAfter     Decimal         @db.Decimal(18, 2)
  reference        String?
  narrative        String?
  performedById    String
  createdAt        DateTime        @default(now())
  savingsAccount   SavingsAccount  @relation(fields: [savingsAccountId], references: [id], onDelete: Restrict)
  performedBy      User            @relation("TransactionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  disbursedLoan    Loan?

  @@index([savingsAccountId, createdAt(sort: Desc)])
  @@index([performedById, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

model AuditLog {
  id            String      @id @default(cuid())
  actorId       String?
  actorRole     UserRole?
  action        AuditAction
  entityType    String
  entityId      String?
  beforeState   Json?
  afterState    Json?
  metadata      Json?
  status        AuditStatus @default(SUCCESS)
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())
  actor         User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([status, createdAt])
}

model SystemSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model PasswordResetRequest {
  id             String               @id @default(cuid())
  userId         String
  identifierType AuthIdentifierType
  channel        PasswordResetChannel
  tokenHash      String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime             @default(now())
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([tokenHash])
  @@index([expiresAt])
}

enum InterestMethod {
  FLAT
  REDUCING_BALANCE
}

enum LoanApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum LoanDecision {
  PENDING
  APPROVED
  REJECTED
}

enum LoanContractStatus {
  AWAITING_SIGNATURE
  SIGNED
  VOID
}

enum LoanStatus {
  ACTIVE
  CLOSED
  DEFAULTED
}

enum LoanScheduleStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

enum LoanPaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
}

model LoanType {
  id                   String         @id @default(cuid())
  name                 String         @unique
  interestMethod       InterestMethod
  interestRate         Decimal        @db.Decimal(7, 4)
  maxTermMonths        Int
  maxMultipleOfSavings Decimal        @db.Decimal(7, 2)
  processingFeePercent Decimal        @db.Decimal(7, 4)
  active               Boolean        @default(true)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)
  applications         LoanApplication[]
}

model LoanApplication {
  id                     String                @id @default(cuid())
  memberId               String
  loanTypeId             String
  amountRequested        Decimal               @db.Decimal(18, 2)
  termMonths             Int
  purpose                String
  status                 LoanApplicationStatus @default(SUBMITTED)
  // Freeze product terms and routing at submission, before any configuration edits.
  loanTypeName           String
  interestMethod         InterestMethod
  interestRate           Decimal               @db.Decimal(7, 4)
  processingFeePercent   Decimal               @db.Decimal(7, 4)
  maxMultipleOfSavings   Decimal               @db.Decimal(7, 2)
  boardApprovalThreshold Decimal               @db.Decimal(18, 2)
  submittedAt            DateTime              @default(now()) @db.Timestamptz(3)
  decidedAt              DateTime?             @db.Timestamptz(3)
  decidedById            String?
  rejectionReason        String?
  member                 Member                @relation(fields: [memberId], references: [id], onDelete: Restrict)
  loanType               LoanType              @relation(fields: [loanTypeId], references: [id], onDelete: Restrict)
  decidedBy              User?                 @relation("LoanDecisionMaker", fields: [decidedById], references: [id], onDelete: Restrict)
  approvalSteps          LoanApprovalStep[]
  contract               LoanContract?
  loan                   Loan?

  @@index([memberId, submittedAt(sort: Desc)])
  @@index([status, submittedAt])
  @@index([loanTypeId])
  @@index([decidedById])
}

model LoanApprovalStep {
  id                String       @id @default(cuid())
  loanApplicationId String
  stepNumber        Int
  approverRole      UserRole
  approverId        String?
  decision          LoanDecision @default(PENDING)
  comment           String?
  decidedAt         DateTime?    @db.Timestamptz(3)
  application       LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Restrict)
  approver          User?        @relation(fields: [approverId], references: [id], onDelete: Restrict)

  @@unique([loanApplicationId, stepNumber])
  @@unique([loanApplicationId, approverRole])
  @@index([approverRole, decision])
  @@index([approverId])
}

// A contract belongs to an approved application. The Loan does not exist until disbursement.
model LoanContract {
  id                 String             @id @default(cuid())
  loanApplicationId  String             @unique
  documentPdf        Bytes
  documentHash       String
  terms              Json
  generatedAt        DateTime           @default(now()) @db.Timestamptz(3)
  status             LoanContractStatus @default(AWAITING_SIGNATURE)
  memberSignedAt     DateTime?          @db.Timestamptz(3)
  signedName         String?
  memberSignaturePng Bytes?
  signatureHash      String?
  signingIpAddress   String?
  signingUserAgent   String?
  consentVersion     String?
  application        LoanApplication    @relation(fields: [loanApplicationId], references: [id], onDelete: Restrict)
  loan               Loan?
}

model Loan {
  id                        String         @id @default(cuid())
  loanApplicationId         String         @unique
  memberId                  String
  contractId                String         @unique
  principal                 Decimal        @db.Decimal(18, 2)
  interestRate              Decimal        @db.Decimal(7, 4)
  interestMethod            InterestMethod
  termMonths                Int
  processingFee             Decimal        @db.Decimal(18, 2)
  netDisbursement           Decimal        @db.Decimal(18, 2)
  disbursementDate          DateTime       @db.Timestamptz(3)
  disbursedById             String
  disbursementTransactionId String         @unique
  status                    LoanStatus     @default(ACTIVE)
  // Total unpaid scheduled principal + interest, excluding the fee withheld up front.
  outstandingBalance        Decimal        @db.Decimal(18, 2)
  application               LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Restrict)
  member                    Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  contract                  LoanContract   @relation(fields: [contractId], references: [id], onDelete: Restrict)
  disbursedBy               User           @relation("LoanDisburser", fields: [disbursedById], references: [id], onDelete: Restrict)
  disbursementTransaction   Transaction    @relation(fields: [disbursementTransactionId], references: [id], onDelete: Restrict)
  schedule                  LoanSchedule[]
  payments                  LoanPayment[]

  @@index([memberId, disbursementDate(sort: Desc)])
  @@index([status])
  @@index([disbursedById])
}

model LoanSchedule {
  id                    String             @id @default(cuid())
  loanId                String
  installmentNumber     Int
  dueDate               DateTime           @db.Date
  principalDue          Decimal            @db.Decimal(18, 2)
  interestDue           Decimal            @db.Decimal(18, 2)
  totalDue              Decimal            @db.Decimal(18, 2)
  principalBalanceAfter Decimal            @db.Decimal(18, 2)
  principalPaid         Decimal            @default(0) @db.Decimal(18, 2)
  interestPaid          Decimal            @default(0) @db.Decimal(18, 2)
  status                LoanScheduleStatus @default(PENDING)
  loan                  Loan               @relation(fields: [loanId], references: [id], onDelete: Restrict)
  allocations           LoanPaymentAllocation[]

  @@unique([id, loanId])
  @@unique([loanId, installmentNumber])
  @@index([status, dueDate])
}

// Immutable receipts. Allocation rows are derived again when a receipt is backdated.
model LoanPayment {
  id                      String            @id @default(cuid())
  loanId                  String
  amount                  Decimal           @db.Decimal(18, 2)
  paymentDate             DateTime          @db.Date
  method                  LoanPaymentMethod
  reference               String            @db.VarChar(100)
  targetInstallmentNumber Int?
  recordedById            String
  createdAt               DateTime          @default(now()) @db.Timestamptz(3)
  loan                    Loan              @relation(fields: [loanId], references: [id], onDelete: Restrict)
  recordedBy              User              @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  allocations             LoanPaymentAllocation[]

  @@unique([id, loanId])
  @@unique([loanId, reference])
  @@index([loanId, paymentDate, createdAt, id])
  @@index([recordedById])
}

model LoanPaymentAllocation {
  paymentId       String
  scheduleId      String
  loanId          String
  principalAmount Decimal      @db.Decimal(18, 2)
  interestAmount  Decimal      @db.Decimal(18, 2)
  payment         LoanPayment  @relation(fields: [paymentId, loanId], references: [id, loanId], onDelete: Restrict)
  schedule        LoanSchedule @relation(fields: [scheduleId, loanId], references: [id, loanId], onDelete: Restrict)

  @@id([paymentId, scheduleId])
  @@index([scheduleId, loanId])
  @@index([loanId])
}
